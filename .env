# 온톨로지(수학 지식 맵) 데이터 API — Cloudflare Worker 주소
REACT_APP_API_URL=https://math-ontology-api.imperial01.workers.dev

# 온톨로지 원본 YAML이 들어있는 GitHub 저장소 ("소유자/저장소이름" 형식)
# 지식 맵 상세 화면의 [원본 수정] 버튼이 이 저장소를 찾아갑니다.
# ⚠️ 아래 값은 추정치입니다. 실제 저장소 주소와 다르면 여기만 고치면 됩니다.
REACT_APP_ONTOLOGY_REPO=imperial01-create/math-ontology-data

# ⚠️ 주의: 이 파일의 값은 빌드 결과물에 그대로 포함되어 브라우저에 공개됩니다.
#         비밀번호 / API 키 / 토큰은 절대 여기에 넣지 마세요.
#         비밀값은 Firebase Functions 환경변수(functions/.env)에 둡니다.
