/* =========================================================================
   임페리얼 학원 Firestore 보안 규칙 v9.0

   [v8.10 대비 핵심 변경]
   1. isStaff()의 '.*@imperial.com$' 이메일 패턴 제거.
      → 모든 계정 이메일이 @imperial.com 이므로 학생·학부모까지 교직원이 되던 치명적 구멍을 차단.
   2. isAdmin()의 이메일/아이디 패턴('admin','master','imperialsys*' 등) 제거.
      → 아이디를 'admin'으로 가입하면 관리자가 되던 권한 상승 경로를 차단.
      → 원장님 계정은 authUid 직접 지정(isOwner)으로만 보장.
   3. users의 'allow get: if true' 제거.
      → 로그인 없이 사용자 문서(과거 평문 비밀번호 포함)를 읽던 경로를 차단.
   4. sms_outbox의 'allow create: if true' 제거.
      → 외부인이 학원 폰으로 임의 문자를 발송(=요금 발생)시키던 경로를 차단.
      → 가입 인증 문자는 이제 서버(Functions)가 admin SDK로 직접 생성한다.
   5. 누락되어 차단 상태였던 raw_call_logs / student_context / daily_briefings 규칙 추가.
      → 안드로이드 앱의 통화요약 등록과 출결 AI 인사이트가 정상 작동하게 됨.
   6. SMS 게이트웨이 계정(admin@imperial.com)을 '관리자'가 아닌
      '제한된 서비스 계정(isGateway)'으로 격하. 업무에 필요한 최소 권한만 부여.
   ========================================================================= */

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // 1. 공통 헬퍼
    // =====================================================================
    function isAuth() { return request.auth != null; }

    function uid() { return isAuth() ? request.auth.uid : 'NO_UID'; }

    // 로그인 이메일 '{safeId}@imperial.com' 에서 safeId 만 추출
    function emailId() {
      return (isAuth() && request.auth.token.email != null)
        ? request.auth.token.email.lower().split('@')[0]
        : 'NO_EMAIL';
    }

    function userPath(appId, id) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(id);
    }

    // 사용자 문서에서 role 조회 (문서/필드가 없어도 안전하게 'none' 반환)
    function docRole(appId) {
      return exists(userPath(appId, emailId()))
        ? get(userPath(appId, emailId())).data.get('role', 'none').lower()
        : (exists(userPath(appId, uid()))
            ? get(userPath(appId, uid())).data.get('role', 'none').lower()
            : 'none');
    }

    /* 역할 판정.
       ⚠️ 성능이 아니라 '정상 동작'이 걸린 부분이다.
       Firestore 규칙에는 문서 조회 횟수 제한이 있다(일괄 작업 20회).
       docRole()은 조회를 하므로, 여러 문서를 한 번에 쓰는 작업(예: 학생이
       클리닉 시간대를 여러 개 신청)에서 한도를 넘겨 권한 거부가 발생했다.
       그래서 로그인 토큰(Custom Claims)의 role을 우선 사용한다 — 조회 0회.
       토큰에 아직 role이 없는 사용자를 위해 문서 조회를 남겨두되,
       아래 규칙들은 role()을 '한 번만' 호출하도록 작성해야 한다. */
    function role(appId) {
      return (isAuth() && request.auth.token.role != null)
        ? request.auth.token.role.lower()
        : docRole(appId);
    }

    // 조회를 아끼기 위해 여러 역할을 한 번의 role() 호출로 검사한다
    function roleIn(appId, allowed) { return isAuth() && role(appId) in allowed; }

    function STAFF() { return ['admin', 'admin_assistant', 'lecturer', 'ta']; }
    function MEMBERS() { return ['admin', 'admin_assistant', 'lecturer', 'ta', 'student', 'parent']; }

    // 원장님 계정 비상 통로 (uid는 위조 불가하므로 안전한 안전장치)
    function isOwner() { return isAuth() && uid() == 'PZYN2Ui7mGUGRgQiByvjRutzzPE3'; }

    // SMS 게이트웨이 전용 서비스 계정 (안드로이드 앱). 관리자 아님.
    function isGateway() { return isAuth() && emailId() == 'admin'; }

    /* 아래 판정 함수들은 모두 role()을 '한 번만' 호출한다.
       예전처럼 isDesk = isAdmin || isAsst 식으로 겹쳐 부르면 문서 조회가
       배로 늘어나 일괄 작업에서 조회 한도를 넘긴다. */
    function isAdmin(appId)  { return isOwner() || roleIn(appId, ['admin']); }
    function isAsst(appId)   { return roleIn(appId, ['admin_assistant']); }
    function isDesk(appId)   { return isOwner() || roleIn(appId, ['admin', 'admin_assistant']); }
    function isLecturer(appId) { return roleIn(appId, ['lecturer']); }
    function isTA(appId)     { return roleIn(appId, ['ta']); }
    function isStudent(appId){ return roleIn(appId, ['student']); }
    function isParent(appId) { return roleIn(appId, ['parent']); }

    // 교직원 = 관리자 + 행정조교 + 강사 + 수업조교 (학생/학부모 절대 포함 안 됨)
    function isStaff(appId)  { return isOwner() || roleIn(appId, STAFF()); }

    function isMe(id) { return isAuth() && (id == emailId() || id == uid()); }

    function myChildren(appId) {
      return exists(userPath(appId, emailId()))
        ? get(userPath(appId, emailId())).data.get('linkedChildrenIds', [])
        : (exists(userPath(appId, uid()))
            ? get(userPath(appId, uid())).data.get('linkedChildrenIds', [])
            : []);
    }

    function isParentOf(appId, studentId) {
      return isParent(appId) && studentId in myChildren(appId);
    }

    // 본인 또는 내 자녀의 데이터인가
    function isMineOrChild(appId, studentId) {
      return isMe(studentId) || isParentOf(appId, studentId);
    }

    // =====================================================================
    // 2. 영단어 마스터 DB
    // =====================================================================
    match /VocabularyDB/{docId} {
      allow read:  if isAuth();
      allow write: if isStaff('imperial-clinic-v1');
    }

    // =====================================================================
    // 3. 아카데미 메인 데이터
    // =====================================================================
    match /artifacts/{appId}/public/data {

      // ---------------------------------------------------------------
      // 사용자
      // 로그인 전 조회는 전면 차단한다. 로그인은 Functions(legacyLoginBridge)가
      // admin SDK로 처리하므로 클라이언트의 비인증 조회가 더 이상 필요 없다.
      // ---------------------------------------------------------------
      match /users/{docId} {
        /* ⚠️ 과거 계정 중에는 문서 ID가 로그인 아이디와 다른 것이 있다(대소문자 등).
           그런 계정은 isMe(docId)로 잡히지 않아 본인 프로필조차 못 읽게 되므로,
           문서에 기록된 authUid가 내 uid와 같으면 '본인'으로 인정한다.
           문서 ID를 바꾸는 방식은 쓰지 않는다 — 수강·성적·출결이 모두 옛 ID를 참조하므로
           ID를 옮기면 그 학생의 과거 데이터가 전부 끊긴다. */
        function isMyUserDoc() {
          return isMe(docId) || (isAuth() && resource != null && resource.data.get('authUid', '') == uid());
        }

        // 단건 조회: 본인 / 내 자녀 / 교직원 / 게이트웨이만
        allow get:    if isMyUserDoc() || isStaff(appId) || isGateway() || isParentOf(appId, docId);
        // 목록 조회(대량 유출 경로): 교직원과 게이트웨이만.
        // 학생/학부모는 담당 강사 이름이 필요할 때 staff_directory를 읽는다.
        allow list:   if isStaff(appId) || isGateway();
        allow create: if isDesk(appId);
        // 본인 수정은 허용하되 role/status 변경은 데스크만 가능 (권한 자가상승 차단)
        allow update: if isDesk(appId)
                      || (isMyUserDoc()
                          && request.resource.data.get('role', '')   == resource.data.get('role', '')
                          && request.resource.data.get('status', '') == resource.data.get('status', ''));
        allow delete: if isAdmin(appId);
      }

      // ---------------------------------------------------------------
      // 교직원 명부 — 이름/역할/과목만 담긴 공개용 사본.
      // 서버(Functions의 syncStaffDirectory)만 갱신한다.
      // 학생/학부모가 '담당 강사 이름'을 보기 위해 users 전체를 읽던 것을 대체한다.
      // ---------------------------------------------------------------
      match /staff_directory/{docId} {
        allow read:  if isAuth();
        allow write: if false;
      }

      // ---------------------------------------------------------------
      // 급여 — 본인 명세서 외 타인 조회 차단
      // ---------------------------------------------------------------
      match /payrolls/{docId} {
        allow read: if isDesk(appId)
                    || (isAuth() && resource != null && (
                          resource.data.get('userId', '') == emailId() ||
                          resource.data.get('userId', '') == uid()
                       ))
                    || (isAuth() && docId.matches('^' + emailId() + '_.*'));
        allow write, delete: if isDesk(appId);
      }

      // ---------------------------------------------------------------
      // 재무
      // ---------------------------------------------------------------
      match /work_logs/{docId}     { allow read, write: if isStaff(appId); }
      match /incomes/{docId}       { allow read, write: if isDesk(appId); }
      match /transactions/{docId}  { allow read, write: if isDesk(appId); }
      match /budgets/{docId}       { allow read, write: if isDesk(appId); }
      // 지출결의: 교직원은 작성 가능, 승인/삭제는 데스크만
      match /expenses/{docId} {
        allow read:   if isStaff(appId);
        allow create: if isStaff(appId);
        allow update: if isDesk(appId)
                      || (isStaff(appId) && resource.data.get('status', 'PENDING') == 'PENDING');
        allow delete: if isDesk(appId);
      }

      // ---------------------------------------------------------------
      // 교무 / 행정
      // ---------------------------------------------------------------
      match /recruitment/{docId}     { allow read, write: if isDesk(appId); }
      match /consultations/{docId}   { allow read, write: if isStaff(appId); }
      match /consult_history/{docId} { allow read, write: if isStaff(appId); }
      match /academic_calendars/{docId} { allow read: if isAuth(); allow write: if isStaff(appId); }
      match /clinic_tasks/{docId} {
        allow read: if isAuth();
        allow create, update: if isStaff(appId);
        allow delete: if isAdmin(appId) || isLecturer(appId);
      }
      match /daily_requests/{docId} { allow read: if isAuth(); allow write: if isStaff(appId); }
      match /call_logs/{docId}      { allow read: if isStaff(appId); allow write: if isStaff(appId); }

      // 안드로이드 게이트웨이 앱이 등록하는 S25 통화 요약 원본
      // (기존 규칙에 누락되어 차단 상태였음 → 기능이 동작하지 않았음)
      match /raw_call_logs/{docId} {
        allow read:   if isStaff(appId);
        allow create: if isGateway() || isStaff(appId);
        allow update, delete: if isAdmin(appId);
      }

      // Functions(processCallLog)가 생성하는 학생 특이사항 태그
      // (기존 규칙에 누락되어 출결 화면 AI 인사이트가 표시되지 않았음)
      match /student_context/{studentId} {
        allow read:  if isStaff(appId) || isMineOrChild(appId, studentId);
        allow write: if isStaff(appId);
      }

      // Functions(generateMorningBriefing)가 생성. 클라이언트는 읽기만.
      match /daily_briefings/{docId} {
        allow read:  if isAuth();
        allow write: if false;
      }

      // ---------------------------------------------------------------
      // 수업 / 출결
      // ---------------------------------------------------------------
      match /classes/{docId}     { allow read: if isAuth(); allow write: if isStaff(appId); }
      match /lectures/{docId}    { allow read: if isAuth(); allow write: if isStaff(appId); }
      match /enrollments/{docId} { allow read: if isAuth(); allow write: if isStaff(appId); }
      match /attendance_logs/{docId} { allow read: if isAuth(); allow write: if isStaff(appId); }
      match /school_strategies/{docId} { allow read: if isAuth(); allow write: if isStaff(appId); }
      match /exam_leaves/{docId} { allow read: if isAuth(); allow write: if isStaff(appId); }

      match /sessions/{docId} {
        allow read: if isAuth();
        allow create, delete: if roleIn(appId, STAFF());
        /* 학생/학부모는 예약 신청·취소요청을 위해 update가 필요하다.
           학생이 연속 시간대를 한 번에 신청하면 여러 문서를 일괄 수정하므로,
           역할 판정을 role() 한 번으로 끝내 조회 한도를 넘지 않게 한다.
           (이 부분이 '클리닉 예약 시 권한 오류'의 원인이었다) */
        allow update: if roleIn(appId, MEMBERS());
      }

      match /schedule_requests/{docId} {
        allow read, create: if isStaff(appId);
        allow update, delete: if isAdmin(appId);
      }

      match /lecture_completions/{docId} {
        allow read:  if isStaff(appId) || (isAuth() && isMineOrChild(appId, resource.data.get('studentId', '')));
        allow write: if isStaff(appId) || (isAuth() && isMe(request.resource.data.get('studentId', '')));
      }

      // ---------------------------------------------------------------
      // 시험 / 성적
      // ---------------------------------------------------------------
      match /integrated_exams/{docId} { allow read: if isAuth(); allow write: if isStaff(appId); }
      match /exam_archive/{docId}     { allow read, write: if isStaff(appId); }

      match /student_exam_diagnostics/{docId} {
        allow read: if isStaff(appId) || (isAuth() && isMineOrChild(appId, resource.data.get('studentId', '')));
        allow create, update: if isStaff(appId)
                              && request.resource.data.score is number
                              && request.resource.data.score >= 0
                              && request.resource.data.score <= 100
                              && request.resource.data.testCategory in ['school', 'concept', 'mock'];
        allow delete: if isAdmin(appId) || isLecturer(appId);
      }

      match /grades/{docId} {
        allow read:   if isStaff(appId) || (isAuth() && isMineOrChild(appId, resource.data.get('studentId', '')));
        allow create: if isStaff(appId) || (isAuth() && isMe(request.resource.data.get('studentId', '')));
        allow update, delete: if isDesk(appId);
      }

      match /concept_stats/{studentId} {
        allow read:  if isStaff(appId) || isMineOrChild(appId, studentId);
        allow write: if isStaff(appId) && request.resource.data.subjectStats is map;
      }

      // ---------------------------------------------------------------
      // 영단어(Voca)
      // ---------------------------------------------------------------
      match /english_stats/{studentId} {
        allow read:  if isStaff(appId) || isMineOrChild(appId, studentId);
        allow write: if isStaff(appId) || isMe(studentId);

        match /word_history/{wordId} {
          allow read:  if isStaff(appId) || isMineOrChild(appId, studentId);
          allow write: if isStaff(appId) || isMe(studentId);
        }
      }

      match /test_sessions/{docId} {
        allow read: if isStaff(appId)
                    || (isAuth() && resource != null && isMineOrChild(appId, resource.data.get('studentId', '')));
        allow create, update, delete: if isStaff(appId)
                    || (isAuth() && isMe(request.resource.data.get('studentId', '')));
      }

      match /voca_rankings/{docId} {
        allow read:  if isAuth();
        allow write: if isStaff(appId) || isStudent(appId);
      }

      // ---------------------------------------------------------------
      // 문자 발송함
      // 가입 인증 문자는 Functions(admin SDK)가 직접 만든다.
      // 클라이언트 무제한 create 를 막아 문자 요금 도용을 차단한다.
      // ---------------------------------------------------------------
      match /sms_outbox/{docId} {
        allow read:   if isStaff(appId) || isGateway();
        allow create: if isStaff(appId);
        allow update: if isStaff(appId) || isGateway();
        allow delete: if isDesk(appId);
      }

      // ---------------------------------------------------------------
      // 환경설정
      // 'schools' 문서만 회원가입 화면(로그인 전)에서 필요하므로 공개 읽기 허용
      // ---------------------------------------------------------------
      match /settings/{docId} {
        allow read:  if isAuth() || docId == 'schools';
        /* 학교 마스터 목록(schools)만 교직원도 추가할 수 있게 합니다.
           상담 데스크가 신규 원생을 등록하다 목록에 없는 학교를 만났을 때
           바로 등록할 수 있어야, 자유 입력으로 표기가 흩어지는 것을 막습니다.
           그 외 설정(요금·시즌·부서 등)은 계속 데스크 전용입니다. */
        allow write: if isDesk(appId) || (docId == 'schools' && isStaff(appId));
      }

    } // /artifacts/{appId}/public/data
  }
}
